# Cloudflare Tunnel token
# Crearlo en: Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
# Configurar el tunnel para: http://tuiameaburre:5050
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Bots de arranque (opcional) ----
# Si NO ponés ANTHROPIC_API_KEY, los bots responden con plantillas (gratis).
# Crear la key en: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Kill-switch general de bots (presencia + respuestas). true por defecto.
BOTS_ENABLED=true
# Usar Claude Haiku para las respuestas de bots (requiere ANTHROPIC_API_KEY). Poné
# false para forzar solo plantillas sin tocar la key.
BOT_LLM_ENABLED=true
# Tope de gasto mensual del LLM en US$. Al alcanzarlo, cae a plantillas.
BOT_BUDGET_USD=20
